# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/travelwizard?schema=public"

# Auth.js / GitHub OAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
AUTH_GITHUB_ID="replace-with-your-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-your-github-oauth-client-secret"
AUTH_URL="http://localhost:3000"

# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps Platform
# Keep the server key private and enable Geocoding API + Routes API.
GOOGLE_MAPS_API_KEY="replace-with-a-server-restricted-google-maps-key"
# Restrict this browser key by website origin and enable Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="replace-with-a-browser-restricted-google-maps-key"

# Optional trip image uploads
UPLOADTHING_TOKEN="replace-with-your-uploadthing-token"
